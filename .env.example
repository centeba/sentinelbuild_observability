# Copy to .env and adjust. All gateway settings use the OBS_ prefix.
# Full reference: docs/USER_MANUAL.md §6.

ENVIRONMENT=development

# ── Grafana admin (required, non-default, with docker-compose.prod.yml) ─────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# GRAFANA_ROOT_URL=https://grafana.example.com

# ── Stores ───────────────────────────────────────────────────────────────────
PROMETHEUS_RETENTION=15d

# ── Local log files (used when the stack is unhealthy) ──────────────────────
# Host directory for obs-gateway/ (stack-health.jsonl, events.jsonl) and
# otel-collector/ (logs.jsonl, queue/).
LOCAL_LOG_DIR=./logs
# Collector log fallback: failover (file only while Loki is down) |
# mirror (always also write the file) | queue (persistent on-disk buffer).
COLLECTOR_FALLBACK_MODE=failover
COLLECTOR_FALLBACK_MAX_MB=50
COLLECTOR_FALLBACK_MAX_BACKUPS=5

# ── Production only (docker-compose.prod.yml refuses to start without them) ─
# Bearer token required on OTLP ingest; senders set
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20<token>
# OTEL_INGEST_TOKEN=change-me

# ── obs-gateway ──────────────────────────────────────────────────────────────
# Where the gateway forwards ingested client telemetry (OTLP/HTTP collector).
# Empty => events are written to the gateway's stdout instead.
OBS_OTEL_ENDPOINT=http://otel-collector:4318

# Log verbosity for the gateway process: DEBUG | INFO | WARNING | ERROR | CRITICAL
OBS_LOG_LEVEL=INFO

# Optional bearer-token verification (enables tenant/user enrichment). Leave
# unset for anonymous-only ingest. Set ONE of secret / jwks_url.
# OBS_JWT_SECRET=change-me-to-at-least-32-random-bytes
# OBS_JWT_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# OBS_JWT_ALGORITHMS=RS256
# OBS_JWT_AUDIENCE=
# OBS_JWT_ISSUER=
OBS_JWT_COMPANY_CLAIM=org_id
OBS_JWT_USER_CLAIM=sub

OBS_JWT_ROLES_CLAIM=roles

# Shared secret required as X-Internal-Key on GET /status and /status/stack
# (service callers). Unset => open when RBAC is off.
# OBS_INTERNAL_API_KEY=change-me

# ── RBAC (docker-compose.secure.yml puts the UI and log/trace/metric APIs behind it)
# none | static | external
OBS_AUTHZ_MODE=none
# static mode: role -> permissions (ui:access, logs:read, traces:read, metrics:read, status:read, *)
# OBS_AUTHZ_ROLE_PERMISSIONS={"obs-admin":["*"],"obs-editor":["ui:access","logs:read","traces:read","metrics:read","status:read"],"obs-viewer":["ui:access","logs:read","traces:read","metrics:read"]}
# OBS_AUTHZ_GRAFANA_ROLES={"obs-admin":"Admin","obs-editor":"Editor","obs-viewer":"Viewer"}
# external mode: your RBAC service (see gateway/src/obs_gateway/authz.py ExternalAuthorizer)
# OBS_AUTHZ_URL=http://rbac:8080/check
# OBS_AUTHZ_TOKEN_COOKIE=obs_token

# ── Stack health monitor ─────────────────────────────────────────────────────
OBS_STACK_CHECK_INTERVAL_SECONDS=15
# OBS_STACK_TARGETS={"otel-collector":"http://otel-collector:13133/","loki":"http://loki:3100/ready","tempo":"http://tempo:3200/ready","prometheus":"http://prometheus:9090/-/ready","grafana":"http://grafana:3000/api/health"}
OBS_FALLBACK_TRIGGER_COMPONENTS=otel-collector,loki,grafana
OBS_FALLBACK_LOG_MAX_BYTES=10485760
OBS_FALLBACK_LOG_BACKUP_COUNT=5

# Fleet health aggregation targets for GET /status: {name: base_url} as JSON.
# OBS_HEALTH_TARGETS={"user-master":"http://user-master:8000","mit-stack-api":"http://mit-stack-api:8000"}
OBS_HEALTH_PATH=/healthz
OBS_HEALTH_TIMEOUT_SECONDS=3

# Ingest hardening. Request body limit = MAX_BATCH_EVENTS x MAX_EVENT_BYTES.
OBS_MAX_EVENT_BYTES=16384
OBS_MAX_BATCH_EVENTS=100
OBS_RATE_LIMIT_PER_MIN=600
OBS_DEDUPE_WINDOW_SECONDS=10

# Reverse proxies in front of the gateway whose X-Forwarded-For is trusted.
# 0 = use the socket peer (gateway reached directly). Set 1 behind one proxy,
# e.g. the react-demo nginx or your app's ingress.
OBS_TRUSTED_PROXY_HOPS=0

# CORS: leave empty to require same-origin (recommended, via a host proxy).
# OBS_CORS_ALLOW_ORIGINS=https://app.example.com
