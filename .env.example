# Copy to .env and adjust. All gateway settings use the OBS_ prefix.

ENVIRONMENT=development

# ── Grafana admin (required, non-default, with docker-compose.prod.yml) ─────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# GRAFANA_ROOT_URL=https://grafana.example.com

# ── Stores ───────────────────────────────────────────────────────────────────
PROMETHEUS_RETENTION=15d

# ── Production only (docker-compose.prod.yml refuses to start without them) ─
# Bearer token required on OTLP ingest; senders set
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20<token>
# OTEL_INGEST_TOKEN=change-me

# ── obs-gateway ──────────────────────────────────────────────────────────────
# Where the gateway forwards ingested client telemetry (OTLP/HTTP collector).
OBS_OTEL_ENDPOINT=http://otel-collector:4318

# Log verbosity for the gateway process: DEBUG | INFO | WARNING | ERROR | CRITICAL
OBS_LOG_LEVEL=INFO

# Optional bearer-token verification (enables tenant/user enrichment). Leave
# unset for anonymous-only ingest. Set ONE of secret / jwks_url.
# OBS_JWT_SECRET=change-me
# OBS_JWT_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# OBS_JWT_ALGORITHMS=HS256,RS256
# OBS_JWT_AUDIENCE=
# OBS_JWT_ISSUER=
OBS_JWT_COMPANY_CLAIM=org_id
OBS_JWT_USER_CLAIM=sub

# Shared secret required as X-Internal-Key on GET /status. Unset => open.
# OBS_INTERNAL_API_KEY=change-me

# Fleet health aggregation targets for GET /status: {name: base_url} as JSON.
# OBS_HEALTH_TARGETS={"user-master":"http://user-master:8000","mit-stack-api":"http://mit-stack-api:8000"}
OBS_HEALTH_PATH=/healthz

# Ingest hardening.
OBS_MAX_EVENT_BYTES=16384
OBS_MAX_BATCH_EVENTS=100
OBS_RATE_LIMIT_PER_MIN=600
OBS_DEDUPE_WINDOW_SECONDS=10

# Reverse proxies in front of the gateway whose X-Forwarded-For is trusted.
# 0 = use the socket peer (gateway reached directly). Set 1 behind one proxy,
# e.g. the react-demo nginx or your app's ingress.
OBS_TRUSTED_PROXY_HOPS=0

# CORS: leave empty to require same-origin (recommended, via a host proxy).
# OBS_CORS_ALLOW_ORIGINS=https://app.example.com
